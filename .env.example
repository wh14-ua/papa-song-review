# Copia este archivo como .env.local y rellena los valores de tu proyecto Supabase
# (Project Settings → API). Si los dejas vacíos, la web funciona igual guardando
# el progreso en el navegador (localStorage).
#
# VITE_SUPABASE_ANON_KEY: usa la clave pública "anon" (o la nueva "publishable",
# sb_publishable_...). NUNCA la service_role ni una "secret" (sb_secret_...):
# todo lo que empieza por VITE_ acaba dentro del JavaScript público.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: identificador de la sesión de revisión (por defecto "papa").
# VITE_REVIEW_SESSION_ID=papa
